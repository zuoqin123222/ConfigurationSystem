{
  "name": "configuration-system-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "validate:bake": "npm run build && node dist/src/validate-bake.js",
    "publish:bake": "npm run build && node dist/src/publish.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3"
  }
}

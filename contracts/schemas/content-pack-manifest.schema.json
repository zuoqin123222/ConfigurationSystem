{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://configurationsystem.local/schemas/content-pack-manifest.schema.json",
  "title": "Configuration System Content Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "catalogVersion",
    "engineVersion",
    "platform",
    "mountPoint",
    "pak",
    "primaryAssetIds"
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "2.0.0"] },
    "packId": { "$ref": "#/$defs/stableId" },
    "version": { "$ref": "#/$defs/stableId" },
    "catalogVersion": { "$ref": "#/$defs/stableId" },
    "providerType": {
      "enum": ["material", "environment", "vehicle"]
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^5\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "platform": { "const": "Win64" },
    "mountPoint": {
      "type": "string",
      "pattern": "^/Game/ContentPacks/[a-z0-9]+(?:-[a-z0-9]+)*/$"
    },
    "pak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.pak$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "primaryAssetIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*:[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": "2.0.0" } },
        "required": ["schemaVersion"]
      },
      "then": { "required": ["providerType"] }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1.0.0" } },
        "required": ["schemaVersion"]
      },
      "then": { "not": { "required": ["providerType"] } }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://configurationsystem.local/schemas/catalog.v2.schema.json",
  "title": "Configuration System Catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "lifecycle",
    "currency",
    "vehicle",
    "selectionOrder",
    "defaultSelections",
    "optionIdAliases",
    "regions",
    "categories",
    "components",
    "surfaces",
    "materialFamilies",
    "materialVariants",
    "assetManifest",
    "options"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "catalogVersion": { "$ref": "#/$defs/id" },
    "lifecycle": { "const": "draft" },
    "currency": { "const": "CNY" },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vehicleId", "displayName", "basePriceMinor", "priceStatus", "quotable"],
      "properties": {
        "vehicleId": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "basePriceMinor": { "const": 22980000 },
        "priceStatus": { "const": "confirmed" },
        "quotable": { "const": false }
      }
    },
    "selectionOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "defaultSelections": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "optionIdAliases": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "interactionCameras": {
      "type": "array",
      "items": { "$ref": "#/$defs/interactionCamera" }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/region" }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "materialFamilies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/materialFamily" }
    },
    "materialVariants": {
      "type": "array",
      "items": { "$ref": "#/$defs/materialVariant" }
    },
    "assetManifest": {
      "type": "string",
      "pattern": "^/"
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/option" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "cameraId": {
      "anyOf": [
        { "$ref": "#/$defs/id" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "nodeUi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": { "type": "integer", "minimum": 0 },
        "iconUrl": {
          "anyOf": [
            { "type": "string", "pattern": "^/" },
            { "type": "null" }
          ]
        },
        "cameraId": {
          "anyOf": [
            { "$ref": "#/$defs/cameraId" },
            { "type": "null" }
          ]
        },
        "navigationMode": { "enum": ["tabs", "list", "none", "surfaces-as-components"] },
        "layout": { "enum": ["single", "stack", "grid"] }
      }
    },
    "materialFamilyUi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variantSort": { "enum": ["achromatic-then-rainbow"] }
      }
    },
    "materialVariantUi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sortColorHex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "interactionCamera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cameraId", "zone", "order", "displayName", "iconUrl"],
      "properties": {
        "cameraId": { "$ref": "#/$defs/cameraId" },
        "legacyIndex": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 5 },
            { "type": "null" }
          ]
        },
        "zone": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 0 },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "iconUrl": { "type": "string", "pattern": "^/" }
      }
    },
    "optionUi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": { "type": "integer", "minimum": 0 },
        "iconUrl": {
          "anyOf": [
            { "type": "string", "pattern": "^/" },
            { "type": "null" }
          ]
        },
        "control": {
          "enum": ["swatch", "thumbnail", "color-picker", "material-variant"]
        },
        "defaultParameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colorHex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "metallic": { "type": "number", "minimum": 0, "maximum": 1 },
            "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
            "clearCoat": { "type": "number", "minimum": 0, "maximum": 1 },
            "orangePeel": { "type": "number", "minimum": 0, "maximum": 1 },
            "flakeIntensity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "page", "locator"],
      "properties": {
        "documentId": { "$ref": "#/$defs/id" },
        "page": { "type": "integer", "minimum": 1 },
        "locator": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId", "displayName", "sourceRefs"],
      "properties": {
        "regionId": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categoryId", "regionId", "displayName", "sourceRefs"],
      "properties": {
        "categoryId": { "$ref": "#/$defs/id" },
        "regionId": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "ui": { "$ref": "#/$defs/nodeUi" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "categoryId", "displayName", "sourceRefs"],
      "properties": {
        "componentId": { "$ref": "#/$defs/id" },
        "categoryId": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "ui": { "$ref": "#/$defs/nodeUi" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "componentId", "displayName", "required", "reviewRequired", "sourceRefs"],
      "properties": {
        "surfaceId": { "$ref": "#/$defs/id" },
        "componentId": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "required": { "type": "boolean" },
        "reviewRequired": { "type": "boolean" },
        "ui": { "$ref": "#/$defs/nodeUi" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "materialFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialFamilyId", "displayName", "sourceRefs"],
      "properties": {
        "materialFamilyId": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "ui": { "$ref": "#/$defs/materialFamilyUi" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "materialVariant": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "materialFamilyId": {
                "enum": ["ultrasuede", "alcantara", "leather", "microfiber"]
              }
            }
          },
          "then": {
            "required": ["ui"],
            "properties": {
              "ui": { "required": ["sortColorHex"] }
            }
          }
        }
      ],
      "required": [
        "variantId",
        "materialFamilyId",
        "displayName",
        "colorCode",
        "thumbnailUrl",
        "reviewRequired",
        "sourceRefs"
      ],
      "properties": {
        "variantId": { "$ref": "#/$defs/id" },
        "materialFamilyId": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "colorCode": {
          "anyOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "ui": { "$ref": "#/$defs/materialVariantUi" },
        "thumbnailUrl": { "type": "string", "pattern": "^/" },
        "reviewRequired": { "type": "boolean" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitPriceMinor",
        "quantity",
        "pricingUnit",
        "isStandard",
        "status",
        "quotable"
      ],
      "properties": {
        "unitPriceMinor": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "quantity": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "pricingUnit": {
          "enum": [
            "per-vehicle",
            "per-piece",
            "per-pair",
            "per-seat",
            "per-set",
            "percentage"
          ]
        },
        "isStandard": { "type": "boolean" },
        "status": { "enum": ["confirmed", "unconfirmed"] },
        "quotable": { "const": false }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optionId",
        "surfaceId",
        "materialFamilyId",
        "displayName",
        "colorCode",
        "finish",
        "renderRelevant",
        "parameters",
        "thumbnailUrl",
        "reviewRequired",
        "pricing",
        "sourceRefs"
      ],
      "properties": {
        "optionId": { "$ref": "#/$defs/id" },
        "surfaceId": { "$ref": "#/$defs/id" },
        "materialFamilyId": {
          "anyOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "colorCode": {
          "anyOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "finish": {
          "anyOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "renderRelevant": { "type": "boolean" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color", "material"],
          "properties": {
            "color": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode", "value", "required"],
                  "properties": {
                    "mode": { "enum": ["fixed", "custom", "choice", "variant"] },
                    "value": {
                      "anyOf": [
                        { "$ref": "#/$defs/nonEmptyString" },
                        { "type": "null" }
                      ]
                    },
                    "required": { "type": "boolean" }
                  }
                },
                { "type": "null" }
              ]
            },
            "material": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["materialFamilyId", "variantId"],
                  "properties": {
                    "materialFamilyId": { "$ref": "#/$defs/id" },
                    "variantId": {
                      "anyOf": [
                        { "$ref": "#/$defs/id" },
                        { "type": "null" }
                      ]
                    }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        },
        "thumbnailUrl": {
          "anyOf": [
            { "type": "string", "pattern": "^/" },
            { "type": "null" }
          ]
        },
        "reviewRequired": { "type": "boolean" },
        "pricing": { "$ref": "#/$defs/pricing" },
        "ui": { "$ref": "#/$defs/optionUi" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    }
  }
}

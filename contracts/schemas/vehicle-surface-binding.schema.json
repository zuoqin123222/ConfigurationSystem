{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://configurationsystem.local/schemas/vehicle-surface-binding.schema.json",
  "title": "Vehicle Surface Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "vehicleId",
    "catalogVersion",
    "modelVersion",
    "sourceFbx",
    "bindings"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "vehicle-surface-binding" },
    "vehicleId": { "$ref": "#/$defs/id" },
    "catalogVersion": { "$ref": "#/$defs/id" },
    "modelVersion": { "$ref": "#/$defs/id" },
    "sourceFbx": { "$ref": "#/$defs/artifact" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/binding" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nodeName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "materialId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "slotId": {
      "type": "string",
      "pattern": "^sc01_[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*\\.\\.).+\\.fbx$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetNode", "sourceMaterialId", "faceRanges"],
      "properties": {
        "targetNode": { "$ref": "#/$defs/nodeName" },
        "sourceMaterialId": { "$ref": "#/$defs/materialId" },
        "faceRanges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:\\*|[0-9]+(?::[0-9]+)?)$"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "materialSlotId", "selectors"],
      "properties": {
        "surfaceId": { "$ref": "#/$defs/id" },
        "materialSlotId": { "$ref": "#/$defs/slotId" },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selector" }
        }
      }
    }
  }
}
